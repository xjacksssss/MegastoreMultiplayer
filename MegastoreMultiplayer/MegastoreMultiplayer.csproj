<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MegastoreMultiplayer</AssemblyName>
    <RootNamespace>MegastoreMultiplayer</RootNamespace>

    <!-- Local game install — update this per machine. CI leaves it unset. -->
    <GameDir>C:\Games\Megastore.Simulator.v0.4.1</GameDir>
    <PluginOutputDir>$(GameDir)\BepInEx\plugins\MegastoreMultiplayer</PluginOutputDir>

    <!-- CI: game DLLs committed to ci-libs/ when GameDir is absent -->
    <CiLibs>$(MSBuildThisFileDirectory)..\ci-libs</CiLibs>
    <RefDir Condition="Exists('$(GameDir)')">$(GameDir)\Megastore Simulator_Data\Managed</RefDir>
    <RefDir Condition="!Exists('$(GameDir)')">$(CiLibs)</RefDir>
    <BepDir Condition="Exists('$(GameDir)')">$(GameDir)\BepInEx\core</BepDir>
    <BepDir Condition="!Exists('$(GameDir)')">$(CiLibs)</BepDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.0" />
    <PackageReference Include="Open.NAT" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx & Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity engine DLLs -->
    <Reference Include="UnityEngine">
      <HintPath>$(RefDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RefDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RefDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RefDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RefDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(RefDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RefDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RefDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- DOTween -->
    <Reference Include="DOTween">
      <HintPath>$(RefDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The game itself -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RefDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After build: copy mod DLL + bundled NuGet DLLs (e.g. LiteNetLib) to BepInEx plugins -->
  <!-- Skipped automatically in CI where GameDir doesn't exist -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)')">
    <MakeDir Directories="$(PluginOutputDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginOutputDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PluginOutputDir)"
          Condition="'%(Extension)' == '.dll'" />
  </Target>
</Project>
