#!/usr/bin/env bash
# Pre-push hook: when pushing a version tag (v*.*.*), refresh ci-libs/ from
# the local game install and auto-commit so CI always builds against the
# current DLLs without any manual copy step.

set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────────────
GAME_DIR="C:/Games/Megastore.Simulator.v0.4.1"
MANAGED="$GAME_DIR/Megastore Simulator_Data/Managed"
BEP_CORE="$GAME_DIR/BepInEx/core"
CI_LIBS="$(git rev-parse --show-toplevel)/ci-libs"

DLLS=(
  "$MANAGED/Assembly-CSharp.dll"
  "$MANAGED/UnityEngine.dll"
  "$MANAGED/UnityEngine.CoreModule.dll"
  "$MANAGED/UnityEngine.IMGUIModule.dll"
  "$MANAGED/UnityEngine.PhysicsModule.dll"
  "$MANAGED/UnityEngine.TextRenderingModule.dll"
  "$MANAGED/UnityEngine.InputLegacyModule.dll"
  "$MANAGED/UnityEngine.AnimationModule.dll"
  "$MANAGED/UnityEngine.AudioModule.dll"
  "$MANAGED/UnityEngine.UIModule.dll"
  "$MANAGED/DOTween.dll"
  "$BEP_CORE/BepInEx.dll"
  "$BEP_CORE/0Harmony.dll"
)

# ── Check if any pushed ref is a version tag ──────────────────────────────────
pushing_version_tag=0
while read local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
    pushing_version_tag=1
    break
  fi
done

if [[ "$pushing_version_tag" -eq 0 ]]; then
  exit 0   # not a release push — nothing to do
fi

echo "[pre-push] Version tag detected — refreshing ci-libs/ from local game install..."

# ── Verify game install exists ────────────────────────────────────────────────
if [[ ! -d "$MANAGED" ]]; then
  echo "[pre-push] ERROR: game directory not found at: $MANAGED"
  echo "           Update GAME_DIR in .githooks/pre-push to match your install path."
  exit 1
fi

# ── Copy DLLs ─────────────────────────────────────────────────────────────────
for dll in "${DLLS[@]}"; do
  if [[ -f "$dll" ]]; then
    cp "$dll" "$CI_LIBS/"
  else
    echo "[pre-push] WARNING: $dll not found — skipping."
  fi
done

# ── Commit if anything changed ────────────────────────────────────────────────
git -C "$(git rev-parse --show-toplevel)" add ci-libs/

if ! git diff --cached --quiet; then
  # Extract game version from Assembly-CSharp filename neighbourhood or just use date
  GAME_VER=$(basename "$GAME_DIR" | grep -oP 'v[\d.]+' || echo "unknown")
  git commit -m "chore: refresh ci-libs for release ($GAME_VER)"
  echo "[pre-push] ci-libs updated and committed."
else
  echo "[pre-push] ci-libs already up to date — no commit needed."
fi
